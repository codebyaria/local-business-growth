# Copy this file to .env and fill in real values.
# Do not commit secrets.

# Strapi base URL used by the typed REST client. Leave empty to fall back
# to the local fixtures in src/data so the build always succeeds.
STRAPI_URL=

# Strapi API token (read-only). Empty in development.
STRAPI_TOKEN=

# Public canonical site origin used for canonical URLs, hreflang, robots.txt,
# and sitemap.xml. Example: https://sejuk-cepat-demo.vercel.app
SITE_ORIGIN=

# Keep indexing disabled by default for local/sandbox builds. Set to true only
# on the intended public demo deployment.
PUBLIC_ENABLE_INDEXING=false