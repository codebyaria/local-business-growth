# Local Business Growth — root environment
# Copy this file to .env and fill in real values. Do not commit secrets.

# Astro (apps/web) public site origin used for canonical URLs, hreflang,
# robots.txt, and sitemap.xml.
# Example: https://sejuk-cepat-web.vercel.app
SITE_ORIGIN=

# Astro STRAPI endpoint. When empty, apps/web uses its in-repo fixtures.
# Example: https://sejuk-cepat-cms.onrender.com
STRAPI_URL=

# Optional read-only API token from the Strapi Users & Permissions plugin.
STRAPI_TOKEN=

# Keep indexing disabled by default. Set to true only for the intended
# public demo deployment.
PUBLIC_ENABLE_INDEXING=false

# Strapi (apps/cms) — see apps/cms/.env.example for the full set
HOST=0.0.0.0
PORT=1337
APP_KEYS=[REDACTED]
API_TOKEN_SALT=[REDACTED]
ADMIN_JWT_SECRET=[REDACTED]
TRANSFER_TOKEN_SALT=[REDACTED]
JWT_SECRET=[REDACTED]
ENCRYPTION_KEY=[REDACTED]

# Database backend: sqlite (default, local dev) or postgres (Render free tier)
DATABASE_CLIENT=sqlite
# SQLite-only path (relative to apps/cms/)
DATABASE_FILENAME=.tmp/data.db
# Postgres-only connection string (Render injects as DATABASE_URL automatically)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=false

ADMIN_EMAIL=admin@sejukcepat.example.id
ADMIN_PASSWORD=[REDACTED]
ADMIN_FIRSTNAME=Sejuk
ADMIN_LASTNAME=Cepat
CORS_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
