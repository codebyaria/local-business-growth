# Strapi environment for @sejukcepat/cms
# Copy this file to .env and fill in real values.
# Do not commit secrets.

HOST=0.0.0.0
PORT=1337
APP_KEYS=[REDACTED],[REDACTED]
API_TOKEN_SALT=[REDACTED]
ADMIN_JWT_SECRET=[REDACTED]
TRANSFER_TOKEN_SALT=[REDACTED]
JWT_SECRET=[REDACTED]
ENCRYPTION_KEY=[REDACTED]

# Database backend: `sqlite` (default, local dev) or `postgres` (Render free tier).
DATABASE_CLIENT=sqlite

# SQLite-only: file in .tmp/data.db (relative to apps/cms/).
DATABASE_FILENAME=.tmp/data.db

# Postgres-only: full connection string. Render injects this automatically as DATABASE_URL.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=false

# Admin user seeded at bootstrap (when DB is empty).
# Change these in your own .env before any real deployment.
ADMIN_EMAIL=admin@sejukcepat.example.id
ADMIN_PASSWORD=[REDACTED]
ADMIN_FIRSTNAME=Sejuk
ADMIN_LASTNAME=Cepat

# Public CORS origins for the Astro frontend (comma-separated).
# Defaults include the local web dev server so first-time setup just works.
CORS_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
