    "summary": {
      "type": "json"
    },
    "description": {
      "type": "json"
    },
    "startingPriceIdr": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "durationMinutes": {
      "type": "integer",
      "required": true,
      "min": 0
    }
  }
}
