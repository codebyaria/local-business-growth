{
  "version": 3,
  "routes": [
    {
      "src": "^/\\.well-known(?:/.*)?$"
    },
    {
      "src": "^/((?:[^/]+/)*[^/\\.]+)$",
      "headers": {
        "Location": "/$1/"
      },
      "status": 308
    },
    {
      "src": "^/((?:[^/]+/)*[^/]+\\.\\w+)/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/_astro/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/_server-islands/([^/]+?)/$",
      "dest": "_render"
    },
    {
      "src": "^/_image/$",
      "dest": "_render"
    },
    {
      "src": "^/api/booking/$",
      "dest": "_render"
    },
    {
      "src": "^/blog/$",
      "dest": "_render"
    },
    {
      "src": "^/booking/success/$",
      "dest": "_render"
    },
    {
      "src": "^/booking/$",
      "dest": "_render"
    },
    {
      "src": "^/contact/$",
      "dest": "_render"
    },
    {
      "src": "^/en/blog/$",
      "dest": "_render"
    },
    {
      "src": "^/en/booking/success/$",
      "dest": "_render"
    },
    {
      "src": "^/en/booking/$",
      "dest": "_render"
    },
    {
      "src": "^/en/contact/$",
      "dest": "_render"
    },
    {
      "src": "^/en/locations/$",
      "dest": "_render"
    },
    {
      "src": "^/en/services/$",
      "dest": "_render"
    },
    {
      "src": "^/en/$",
      "dest": "_render"
    },
    {
      "src": "^/locations/$",
      "dest": "_render"
    },
    {
      "src": "^/services/$",
      "dest": "_render"
    },
    {
      "src": "^/$",
      "dest": "_render"
    }
  ]
}
