---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../../lib/content-adapter.ts';
import { tFor } from '../../../lib/ui-strings.ts';
import { pickLocale, type Locale } from '../../../lib/strapi-client.ts';
import { fixtureServices } from '../../../lib/fixtures.ts';
import { localeFromPath, localizedHref } from '../../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const services = await adapter.fetchServices();
const servicesForLocale = services.length > 0 ? services : fixtureServices;

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

const priceFormatter = new Intl.NumberFormat(locale === 'id' ? 'id-ID' : 'en-US');
---

<BaseLayout title={t.services.title} description={t.services.pageLead} locale={locale}>
  <section class="container page" aria-labelledby="services-title">
    <div class="page-hero">
      <p class="pill">❄ {t.services.title} · {servicesForLocale.length}</p>
      <h1 id="services-title">{t.services.pageHeading}</h1>
      <p class="lead">{t.services.pageLead}</p>
    </div>

    <ul class="service-list">
      {
        servicesForLocale.map((service, index) => (
          <li class="service-row">
            <div class="service-row__number">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <h2>
                <a href={localizedHref(locale, `/services/${service.slug}/`)}>
                  {pickLocale(service.name, locale)}
                </a>
              </h2>
              <p class="summary">{pickLocale(service.summary, locale)}</p>
            </div>
            <div class="meta-card">
              <span>{t.home.startingFrom}</span>
              <strong>
                {priceFormatter.format(service.startingPriceIdr)} {t.home.currency}
              </strong>
              <small>
                ~{service.durationMinutes} {t.service.minutes}
              </small>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2rem, 6vw, 5rem);
    display: grid;
    gap: 1.5rem;
  }
  .page-hero {
    display: grid;
    gap: 0.75rem;
    max-width: 720px;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.15rem, 5vw, 4.1rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
  }
  .lead,
  .summary {
    color: var(--soft-ink);
    margin: 0;
  }
  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .service-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(12rem, auto);
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .service-row__number {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 16px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-weight: 620;
  }
  h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
  }
  h2 a {
    text-decoration: none;
  }
  .meta-card {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-md);
    background: var(--surface-tint);
    text-align: right;
  }
  .meta-card span,
  .meta-card small {
    color: var(--soft-ink);
    font-size: 0.82rem;
  }
  .meta-card strong {
    color: var(--accent-strong);
    font-size: 1.05rem;
  }
  @media (max-width: 760px) {
    .service-row {
      grid-template-columns: 1fr;
    }
    .meta-card {
      text-align: left;
    }
  }
</style>
