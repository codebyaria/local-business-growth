---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../lib/content-adapter.ts';
import { tFor } from '../../lib/ui-strings.ts';
import { pickLocale, type Locale, type Article } from '../../lib/strapi-client.ts';
import { fixtureArticles } from '../../lib/fixtures.ts';
import { localeFromPath, localizedHref } from '../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const all = await adapter.fetchArticles();
const allForLocale = all.length > 0 ? all : fixtureArticles;

export async function getStaticPaths() {
  const adapter = createContentAdapter({
    strapiUrl: import.meta.env.STRAPI_URL,
    strapiToken: import.meta.env.STRAPI_TOKEN,
  });
  const all = await adapter.fetchArticles();
  const allForLocale = all.length > 0 ? all : fixtureArticles;
  return allForLocale.map((article) => ({
    params: { slug: article.slug },
  }));
}

export const prerender = true;

const { slug } = Astro.params;
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

const article: Article | undefined = allForLocale.find((a) => a.slug === slug);
if (!article) {
  return Astro.redirect(localizedHref(locale, '/blog/'), 302);
}

const formatter = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={pickLocale(article.title, locale)}
  description={pickLocale(article.excerpt, locale)}
  locale={locale}
>
  <article class="container post">
    <p class="label">{t.blogPost.eyebrow}</p>
    <h1>{pickLocale(article.title, locale)}</h1>
    <p class="meta">
      {formatter.format(new Date(article.publishedAt))} · {article.readMinutes}{' '}
      {t.blog.minRead}
    </p>
    <p class="lead">{pickLocale(article.excerpt, locale)}</p>
    <p class="back">
      <a href={localizedHref(locale, '/blog/')}>{t.blogPost.backToBlog}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2rem, 5vw, 4rem);
    display: grid;
    gap: 0.9rem;
    max-width: 680px;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--soft-ink);
    margin: 0;
  }
  .lead {
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }
  .back {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }
  .back a {
    border-bottom: 2px solid transparent;
  }
  .back a:hover,
  .back a:focus-visible {
    border-bottom-color: var(--accent);
  }
</style>
