---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../../lib/content-adapter.ts';
import { tFor } from '../../../lib/ui-strings.ts';
import { pickLocale, type Locale } from '../../../lib/strapi-client.ts';
import { fixtureArticles } from '../../../lib/fixtures.ts';
import { localeFromPath, localizedHref } from '../../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const articles = await adapter.fetchArticles();
const articlesForLocale = articles.length > 0 ? articles : fixtureArticles;
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

const formatter = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

function visualFor(index: number): string {
  return ['cleaning', 'freon', 'refrigerant', 'fridge'][index % 4] ?? 'cleaning';
}
---

<BaseLayout title={t.blog.title} description={t.blog.pageLead} locale={locale}>
  <section class="container page" aria-labelledby="blog-title">
    <div class="page-hero">
      <p class="pill">🧰 {t.blog.title} · {articlesForLocale.length}</p>
      <h1 id="blog-title">{t.blog.pageHeading}</h1>
      <p class="lead">{t.blog.pageLead}</p>
    </div>

    <ul class="article-grid">
      {
        articlesForLocale.map((article, index) => (
          <li class="article-card">
            <a
              class="article-card__visual"
              data-visual={visualFor(index)}
              href={localizedHref(locale, `/blog/${article.slug}/`)}
              aria-label={pickLocale(article.title, locale)}
            >
              <span aria-hidden="true" />
            </a>
            <div class="article-card__body">
              <p class="meta">
                {formatter.format(new Date(article.publishedAt))} · {article.readMinutes}{' '}
                {t.blog.minRead}
              </p>
              <h2>
                <a href={localizedHref(locale, `/blog/${article.slug}/`)}>
                  {pickLocale(article.title, locale)}
                </a>
              </h2>
              <p class="excerpt">{pickLocale(article.excerpt, locale)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2rem, 6vw, 5rem);
    display: grid;
    gap: 1.5rem;
  }
  .page-hero {
    display: grid;
    gap: 0.75rem;
    max-width: 720px;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 4.2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
  }
  .lead,
  .excerpt {
    color: var(--soft-ink);
    margin: 0;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .article-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .article-card__visual {
    position: relative;
    display: block;
    min-height: 11rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 72% 26%, rgb(255 255 255 / 82%) 0 2.5rem, transparent 2.6rem),
      linear-gradient(135deg, var(--accent-soft), #effbff 52%, #fff2c7);
  }
  .article-card__visual::before {
    position: absolute;
    inset: 2.6rem auto auto 50%;
    width: 8rem;
    height: 2.6rem;
    border: 1px solid rgb(90 107 118 / 16%);
    border-radius: 0.7rem 0.7rem 1.1rem 1.1rem;
    background: linear-gradient(180deg, #ffffff, #eef7fa);
    box-shadow: 0 18px 34px rgb(90 107 118 / 16%);
    content: '';
    transform: translateX(-50%);
  }
  .article-card__visual::after {
    position: absolute;
    inset: auto 1.1rem 1.1rem auto;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 78%);
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 610;
    box-shadow: var(--shadow-sm);
  }
  .article-card__visual[data-visual='cleaning']::after {
    content: 'AC care';
  }
  .article-card__visual[data-visual='freon']::after {
    content: 'Freon check';
  }
  .article-card__visual[data-visual='refrigerant']::after {
    content: 'R32 guide';
  }
  .article-card__visual[data-visual='fridge']::after {
    content: 'Fridge repair';
  }
  .article-card__body {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
  }
  .meta {
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 600;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  h2 a {
    text-decoration: none;
  }
</style>
