{
  "name": "local-business-growth",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@astrojs/node": "^9.4.7",
    "astro": "^5.1.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.6.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "typescript": ">=6.0.0 <7.0.0"
    }
  }
