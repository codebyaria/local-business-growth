---
import type { Locale } from '../lib/i18n.ts';
import { localizedHref } from '../lib/i18n.ts';

type Props = {
  locale: Locale;
};
const { locale } = Astro.props;
const year = new Date().getFullYear();
const t = {
  id: {
    classification: 'Jadwalkan teknisi AC dan kulkas untuk area Jabodetabek.',
    credit: 'Aria Nurhadi Zain',
    book: 'Booking teknisi',
    services: 'Lihat layanan',
  },
  en: {
    classification: 'Book AC and fridge technicians for homes and small shops in Jabodetabek.',
    credit: 'Aria Nurhadi Zain',
    book: 'Book a technician',
    services: 'Browse services',
  },
}[locale];
---

<footer class="site-footer">
  <div class="container footer-card">
    <div>
      <p class="label">Sejuk Cepat</p>
      <h2>{locale === 'id' ? 'Siap jadwalkan teknisi?' : 'Ready to schedule a technician?'}</h2>
      <p>{t.classification}</p>
    </div>
    <div class="footer-actions">
      <a class="button button--primary" href={localizedHref(locale, '/booking/')}>{t.book}</a>
      <a class="button" href={localizedHref(locale, '/services/')}>{t.services}</a>
    </div>
  </div>
  <div class="container site-footer__row">
    <p>&copy; <span>{year}</span> {t.credit}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .footer-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgb(0 166 147 / 14%), transparent 42%), var(--surface);
    box-shadow: var(--shadow-sm);
  }
  h2 {
    margin: 0.35rem 0 0.45rem;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  p {
    margin: 0;
    color: var(--soft-ink);
  }
  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: flex-end;
  }
  .site-footer__row {
    padding-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--soft-ink);
  }
  @media (max-width: 720px) {
    .footer-card {
      grid-template-columns: 1fr;
    }
    .footer-actions {
      justify-content: flex-start;
    }
  }
</style>
