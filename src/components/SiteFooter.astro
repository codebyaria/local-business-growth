---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <p>Concept / demo project · Northside Roofing is fictional.</p>
    <p>&copy; <span>{year}</span> Aria Nurhadi Zain · Built with Astro + Strapi adapter</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--ink);
    margin-top: clamp(3rem, 8vw, 6rem);
  }
  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: var(--space-lg, 1.5rem);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--soft-ink);
  }
  p {
    margin: 0;
  }
</style>
