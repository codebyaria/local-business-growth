---
import type { Locale } from '../lib/i18n.ts';

type Props = {
  locale: Locale;
};
const { locale } = Astro.props;
const year = new Date().getFullYear();
const t = {
  id: {
    classification: 'Konsep / proyek demo · Sejuk Cepat adalah brand fiksi.',
    credit: 'Aria Nurhadi Zain · Dibangun dengan Astro + adapter Strapi',
  },
  en: {
    classification: 'Concept / demo project · Sejuk Cepat is a fictional brand.',
    credit: 'Aria Nurhadi Zain · Built with Astro + Strapi adapter',
  },
}[locale];
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <p>{t.classification}</p>
    <p>&copy; <span>{year}</span> {t.credit}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--ink);
    margin-top: clamp(3rem, 8vw, 6rem);
  }
  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: var(--space-lg, 1.5rem);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--soft-ink);
  }
  p {
    margin: 0;
  }
</style>
