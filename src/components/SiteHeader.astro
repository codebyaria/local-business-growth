---
import type { Locale } from '../lib/i18n.ts';
import { localizedHref } from '../lib/i18n.ts';

type Props = {
  locale: Locale;
};
const { locale } = Astro.props;
const t = {
  id: {
    home: 'Beranda',
    services: 'Layanan',
    locations: 'Area',
    blog: 'Blog',
    contact: 'Kontak',
    book: 'Booking',
  },
  en: {
    home: 'Home',
    services: 'Services',
    locations: 'Areas',
    blog: 'Blog',
    contact: 'Contact',
    book: 'Book',
  },
}[locale];

const links = [
  { href: localizedHref(locale, '/'), label: t.home },
  { href: localizedHref(locale, '/services/'), label: t.services },
  { href: localizedHref(locale, '/locations/'), label: t.locations },
  { href: localizedHref(locale, '/blog/'), label: t.blog },
  { href: localizedHref(locale, '/booking/'), label: t.book },
  { href: localizedHref(locale, '/contact/'), label: t.contact },
];

const otherLocale: Locale = locale === 'id' ? 'en' : 'id';
const switchLabel: Record<Locale, string> = { id: 'EN', en: 'ID' };
const switchHref = localizedHref(otherLocale, Astro.url.pathname.replace(/^\/(en|id)/, '') || '/');

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__row">
    <a class="site-header__mark" href={localizedHref(locale, '/')}>
      <span class="site-header__avatar" aria-hidden="true">SC</span>
      <span>Sejuk Cepat</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => [
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? 'page' : undefined}
                class={path === link.href ? 'is-current' : ''}
              >
                {link.label}
              </a>
            </li>,
            <li class="lang-switch">
              <a
                href={switchHref}
                hreflang={otherLocale}
                lang={otherLocale}
                rel="alternate"
                aria-label={`Switch language to ${otherLocale.toUpperCase()}`}
              >
                {switchLabel[otherLocale]}
              </a>
            </li>,
          ])
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
  }
  .site-header__row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    min-height: 76px;
  }
  .site-header__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 800;
    text-decoration: none;
  }
  .site-header__avatar {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    background: var(--ink);
    color: var(--inverse);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    justify-content: flex-end;
    align-items: center;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  a.is-current,
  a:hover,
  a:focus-visible {
    border-bottom-color: var(--accent);
  }
  .lang-switch a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding-inline: 0.5rem;
    border: 1px solid var(--line);
    margin-left: 0.5rem;
    min-height: 32px;
  }
  @media (max-width: 720px) {
    .site-header__row {
      grid-template-columns: 1fr;
    }
    ul {
      justify-content: flex-start;
    }
  }
</style>
