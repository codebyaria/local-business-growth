---
import type { Locale } from '../lib/i18n.ts';
import { localizedHref, stripLocalePrefix } from '../lib/i18n.ts';

type Props = {
  locale: Locale;
};
const { locale } = Astro.props;
const t = {
  id: {
    home: 'Beranda',
    services: 'Layanan',
    locations: 'Area',
    blog: 'Tips',
    contact: 'Kontak',
    book: 'Booking',
    switchLanguage: 'Ganti bahasa ke English',
  },
  en: {
    home: 'Home',
    services: 'Services',
    locations: 'Areas',
    blog: 'Tips',
    contact: 'Contact',
    book: 'Book',
    switchLanguage: 'Switch language to Indonesian',
  },
}[locale];

const links = [
  { href: localizedHref(locale, '/'), label: t.home },
  { href: localizedHref(locale, '/services/'), label: t.services },
  { href: localizedHref(locale, '/locations/'), label: t.locations },
  { href: localizedHref(locale, '/blog/'), label: t.blog },
  { href: localizedHref(locale, '/contact/'), label: t.contact },
];

const otherLocale: Locale = locale === 'id' ? 'en' : 'id';
const switchLabel: Record<Locale, string> = { id: 'ID', en: 'EN' };
const switchHref = localizedHref(otherLocale, stripLocalePrefix(Astro.url.pathname));
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__row">
    <a class="site-header__mark" href={localizedHref(locale, '/')}>
      <span class="site-header__avatar" aria-hidden="true">❄</span>
      <span class="site-header__brand">
        <strong>Sejuk Cepat</strong>
        <small
          >{locale === 'id' ? 'AC & kulkas se-Jabodetabek' : 'Cooling care across Jakarta'}</small
        >
      </span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? 'page' : undefined}
                class={path === link.href ? 'is-current' : ''}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="lang-switch">
          <a
            href={switchHref}
            hreflang={otherLocale}
            lang={otherLocale}
            rel="alternate"
            aria-label={t.switchLanguage}
          >
            {switchLabel[otherLocale]}
          </a>
        </li>
        <li class="nav-cta">
          <a href={localizedHref(locale, '/booking/')}>{t.book}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgb(213 230 236 / 80%);
    background: rgb(248 253 255 / 88%);
    backdrop-filter: blur(18px);
  }
  .site-header__row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    min-height: 78px;
  }
  .site-header__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 850;
    text-decoration: none;
  }
  .site-header__avatar {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--accent-soft), var(--surface));
    color: var(--accent-strong);
    box-shadow: var(--shadow-sm);
    font-size: 1.15rem;
  }
  .site-header__brand {
    display: grid;
    line-height: 1.15;
  }
  .site-header__brand small {
    color: var(--soft-ink);
    font-size: 0.72rem;
    font-weight: 700;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.45rem;
    justify-content: flex-end;
    align-items: center;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: 0.72rem;
    border-radius: 999px;
    color: var(--soft-ink);
    font-weight: 800;
    text-decoration: none;
  }
  a.is-current,
  a:hover,
  a:focus-visible {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .lang-switch a {
    min-height: 34px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }
  .nav-cta a {
    min-height: 42px;
    background: var(--ink);
    color: var(--inverse);
    box-shadow: var(--shadow-sm);
  }
  @media (max-width: 820px) {
    .site-header {
      position: static;
    }
    .site-header__row {
      grid-template-columns: 1fr;
      padding-block: 0.75rem;
    }
    ul {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.2rem;
    }
    .site-header__brand small {
      display: none;
    }
  }
</style>
