---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Locale } from '../lib/i18n.ts';
import { DEFAULT_LOCALE, localizedHref, stripLocalePrefix } from '../lib/i18n.ts';

type Props = {
  title: string;
  description: string;
  canonical?: string;
  locale?: Locale;
};

const { title, description, canonical, locale = DEFAULT_LOCALE } = Astro.props;
const siteName = 'Sejuk Cepat';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const origin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const path = Astro.url.pathname;
const localeFreePath = stripLocalePrefix(path);
const enPath = localizedHref('en', localeFreePath);
const idPath = localizedHref('id', localeFreePath);
const canonicalHref = canonical ?? (origin ? `${origin}${path}` : undefined);
const shouldIndex = import.meta.env.PUBLIC_ENABLE_INDEXING === 'true';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={shouldIndex ? 'index,follow' : 'noindex,nofollow'} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {
      origin && (
        <>
          <link rel="alternate" hreflang="id" href={`${origin}${idPath}`} />
          <link rel="alternate" hreflang="en" href={`${origin}${enPath}`} />
          <link rel="alternate" hreflang="x-default" href={`${origin}${idPath}`} />
        </>
      )
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'id' ? 'Lewati ke konten' : 'Skip to content'}</a>
    <SiteHeader locale={locale} />
    <main id="main"><slot /></main>
    <SiteFooter locale={locale} />
    <a class="mobile-booking" href={localizedHref(locale, '/booking/')}>
      <span>{locale === 'id' ? 'Booking teknisi' : 'Book technician'}</span>
      <strong>{locale === 'id' ? 'Hari ini' : 'Today'}</strong>
    </a>
  </body>
</html>

<style>
  .mobile-booking {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 40;
    display: none;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: var(--inverse);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    font-weight: 620;
  }
  .mobile-booking strong {
    border-radius: 999px;
    background: rgb(255 255 255 / 18%);
    padding: 0.25rem 0.6rem;
    font-size: 0.82rem;
  }
  @media (max-width: 720px) {
    .mobile-booking {
      display: flex;
    }
  }
</style>
