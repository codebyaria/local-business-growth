---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../../lib/content-adapter.ts';
import { tFor } from '../../../lib/ui-strings.ts';
import { pickLocale, type Locale } from '../../../lib/strapi-client.ts';
import { fixtureArticles } from '../../../lib/fixtures.ts';
import { localeFromPath, localizedHref } from '../../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const articles = await adapter.fetchArticles();
const articlesForLocale = articles.length > 0 ? articles : fixtureArticles;
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

const formatter = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={t.blog.title} description={t.blog.pageLead} locale={locale}>
  <section class="container page" aria-labelledby="blog-title">
    <p class="label">{t.blog.title} · {articlesForLocale.length}</p>
    <h1 id="blog-title">{t.blog.pageHeading}</h1>
    <p class="lead">{t.blog.pageLead}</p>

    <ul class="list">
      {
        articlesForLocale.map((article) => (
          <li class="row">
            <h2>
              <a href={localizedHref(locale, `/blog/${article.slug}/`)}>
                {pickLocale(article.title, locale)}
              </a>
            </h2>
            <p class="meta">
              {formatter.format(new Date(article.publishedAt))} · {article.readMinutes}{' '}
              {t.blog.minRead}
            </p>
            <p class="excerpt">{pickLocale(article.excerpt, locale)}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
  }
  .lead {
    color: var(--soft-ink);
    margin: 0;
    max-width: 60ch;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .row {
    border-top: 1px solid var(--line);
    padding-block: 1rem;
    display: grid;
    gap: 0.4rem;
  }
  .row h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .row h2 a {
    border-bottom: 2px solid transparent;
  }
  .row h2 a:hover,
  .row h2 a:focus-visible {
    border-bottom-color: var(--accent);
  }
  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--soft-ink);
  }
  .excerpt {
    color: var(--soft-ink);
    margin: 0;
  }
</style>
