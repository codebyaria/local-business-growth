---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../lib/content-adapter.ts';
import { tFor } from '../../lib/ui-strings.ts';
import { localeFromPath } from '../../lib/i18n.ts';
import { pickLocale, type Locale } from '../../lib/strapi-client.ts';
import { fixtureServices } from '../../lib/fixtures.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const [services, settings] = await Promise.all([
  adapter.fetchServices(),
  adapter.fetchSiteSettings(),
]);
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

const servicesForLocale = services.length > 0 ? services : fixtureServices;
---

<BaseLayout title={t.booking.title} description={t.booking.pageLead} locale={locale}>
  <section class="container page" aria-labelledby="booking-title">
    <p class="label">{t.booking.title}</p>
    <h1 id="booking-title">{t.booking.pageHeading}</h1>
    <p class="lead">{t.booking.pageLead}</p>

    <form id="booking-form" method="post" action="/api/booking/" class="booking-form" novalidate>
      <input type="hidden" name="locale" value={locale} />

      <fieldset>
        <legend>{t.booking.sectionService}</legend>
        <label class="field">
          <span>{t.booking.serviceLabel}</span>
          <select name="serviceSlug" required>
            <option value="">{t.booking.servicePlaceholder}</option>
            {
              servicesForLocale.map((s) => (
                <option value={s.slug}>{pickLocale(s.name, locale)}</option>
              ))
            }
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend>{t.booking.sectionUnit}</legend>
        <label class="field">
          <span>{t.booking.unitTypeLabel}</span>
          <select name="unitType" required>
            <option value="split">{t.booking.unitTypeOptions.split}</option>
            <option value="window">{t.booking.unitTypeOptions.window}</option>
            <option value="cassette">{t.booking.unitTypeOptions.cassette}</option>
            <option value="standing_floor">{t.booking.unitTypeOptions.standing_floor}</option>
          </select>
        </label>
        <label class="field">
          <span>{t.booking.brandLabel}</span>
          <select name="brand" required>
            <option value="daikin">{t.booking.brandOptions.daikin}</option>
            <option value="lg">{t.booking.brandOptions.lg}</option>
            <option value="panasonic">{t.booking.brandOptions.panasonic}</option>
            <option value="sharp">{t.booking.brandOptions.sharp}</option>
            <option value="samsung">{t.booking.brandOptions.samsung}</option>
            <option value="gree">{t.booking.brandOptions.gree}</option>
            <option value="aux">{t.booking.brandOptions.aux}</option>
            <option value="daewoo">{t.booking.brandOptions.daewoo}</option>
            <option value="other">{t.booking.brandOptions.other}</option>
          </select>
        </label>
        <label class="field" data-show-when="other">
          <span>{t.booking.brandOtherLabel}</span>
          <input type="text" name="brandOther" autocomplete="off" />
        </label>
        <label class="field">
          <span>{t.booking.issueLabel}</span>
          <textarea name="issue" rows="3" required minlength="5"></textarea>
          <small class="help">{t.booking.issueHelp}</small>
        </label>
      </fieldset>

      <fieldset>
        <legend>{t.booking.sectionSchedule}</legend>
        <label class="field">
          <span>{t.booking.addressLabel}</span>
          <input type="text" name="address" required minlength="5" autocomplete="street-address" />
        </label>
        <label class="field">
          <span>{t.booking.preferredDateLabel}</span>
          <input type="date" name="preferredDate" required />
        </label>
        <label class="field">
          <span>{t.booking.urgencyLabel}</span>
          <select name="urgency" required>
            <option value="asap">{t.booking.urgencyOptions.asap}</option>
            <option value="today">{t.booking.urgencyOptions.today}</option>
            <option value="this_week">{t.booking.urgencyOptions.this_week}</option>
            <option value="flexible">{t.booking.urgencyOptions.flexible}</option>
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend>{t.booking.sectionContact}</legend>
        <label class="field">
          <span>{t.booking.nameLabel}</span>
          <input type="text" name="contactName" required minlength="2" autocomplete="name" />
        </label>
        <label class="field">
          <span>{t.booking.phoneLabel}</span>
          <input
            type="tel"
            name="contactPhone"
            required
            pattern="^[+\d][\d\s\-()]{6,}$"
            autocomplete="tel"
          />
        </label>
        <label class="field">
          <span>{t.booking.emailLabel}</span>
          <input type="email" name="contactEmail" autocomplete="email" />
        </label>
        <label class="field">
          <span>{t.booking.notesLabel}</span>
          <textarea name="notes" rows="2"></textarea>
        </label>
      </fieldset>

      <div id="booking-error" role="alert" hidden></div>
      <div class="form-actions">
        <button type="submit" id="booking-submit">{t.booking.submit}</button>
      </div>
    </form>

    <p class="footnote">
      {
        locale === 'id'
          ? 'Demo portfolio: booking menghasilkan nomor referensi dan siap dihubungkan ke koleksi Bookings di Strapi.'
          : 'Portfolio demo: booking returns a reference number and is ready to connect to a Strapi Bookings collection.'
      }
      · Contact: <code>{settings.contact.email}</code>
    </p>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('booking-submit') as HTMLButtonElement | null;
  const errorBox = document.getElementById('booking-error') as HTMLDivElement | null;
  const brandSelect = form?.elements.namedItem('brand') as HTMLSelectElement | null;
  const brandOtherField = form?.querySelector('[data-show-when="other"]') as HTMLElement | null;

  if (brandSelect && brandOtherField) {
    const sync = (): void => {
      brandOtherField.hidden = brandSelect.value !== 'other';
    };
    brandSelect.addEventListener('change', sync);
    sync();
  }

  if (form && submitBtn && errorBox) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.hidden = true;
      errorBox.textContent = '';
      submitBtn.disabled = true;
      const original = submitBtn.textContent;
      submitBtn.textContent = submitBtn.dataset.submitting ?? 'Submitting…';

      try {
        const formData = new FormData(form);
        const res = await fetch('/api/booking/', { method: 'POST', body: formData });
        const body = (await res.json()) as {
          ok: boolean;
          id?: number;
          field?: string;
          message?: string;
        };
        if (!res.ok || !body.ok) {
          errorBox.hidden = false;
          errorBox.textContent = body.message ?? 'Submission failed';
          return;
        }
        const ref = body.id ?? '';
        const localeValue = (formData.get('locale') as string) || 'id';
        window.location.href = `${localeValue === 'en' ? '/en' : ''}/booking/success/?ref=${ref}`;
      } catch (err) {
        errorBox.hidden = false;
        errorBox.textContent = err instanceof Error ? err.message : 'Network error';
      } finally {
        submitBtn.disabled = false;
        if (original) submitBtn.textContent = original;
      }
    });
  }
</script>

<style>
  .page {
    padding-block: clamp(2rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
    max-width: 720px;
  }
  .lead {
    color: var(--soft-ink);
    margin: 0;
  }
  .booking-form {
    display: grid;
    gap: 1.25rem;
  }
  fieldset {
    border: 1px solid var(--line);
    padding: 1rem 1.1rem 1.2rem;
    display: grid;
    gap: 0.85rem;
  }
  legend {
    padding-inline: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--soft-ink);
  }
  .field {
    display: grid;
    gap: 0.35rem;
  }
  .field > span {
    font-weight: 620;
    font-size: 0.9rem;
  }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    background: var(--inverse);
    color: var(--ink);
    border-radius: 0;
  }
  .field textarea {
    resize: vertical;
  }
  .help {
    color: var(--soft-ink);
    font-size: 0.78rem;
  }
  .form-actions {
    display: flex;
    justify-content: flex-end;
  }
  button {
    background: var(--ink);
    color: var(--inverse);
    border: 0;
    padding: 0.75rem 1.5rem;
    font: inherit;
    font-weight: 620;
    cursor: pointer;
    min-height: 48px;
  }
  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  #booking-error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
    padding: 0.7rem 0.9rem;
    font-size: 0.9rem;
  }
  .footnote {
    color: var(--soft-ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
