---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tFor } from '../../../lib/ui-strings.ts';
import type { Locale } from '../../../lib/strapi-client.ts';
import { localeFromPath, localizedHref } from '../../../lib/i18n.ts';

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
const ref = Astro.url.searchParams.get('ref') ?? '';
const whatsappNumber = '+6281200000000';
const whatsappText = encodeURIComponent(
  locale === 'id'
    ? `Halo, saya baru saja booking service dan dapat referensi ${ref}.`
    : `Hi, I just submitted a service booking and got reference ${ref}.`,
);
---

<BaseLayout title={t.booking.successHeading} description={t.booking.successLead} locale={locale}>
  <section class="container success" aria-labelledby="success-title">
    <p class="label">{t.booking.successHeading}</p>
    <h1 id="success-title">{t.booking.successHeading}</h1>
    <p class="lead">{t.booking.successLead}</p>
    {
      ref && (
        <p class="ref">
          <strong>{t.booking.successIdLabel}:</strong> <code>{ref}</code>
        </p>
      )
    }
    <div class="actions">
      <a
        class="button button--primary"
        href={`https://wa.me/${whatsappNumber.replace(/[^\d]/g, '')}?text=${whatsappText}`}
      >
        {t.booking.successWhatsappCta}
      </a>
      <a class="button" href={localizedHref(locale, '/')}>{t.booking.successBackHome}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .success {
    padding-block: clamp(3rem, 7vw, 5rem);
    display: grid;
    gap: 1rem;
    max-width: 640px;
  }
  .lead {
    color: var(--soft-ink);
    margin: 0;
  }
  .ref {
    background: var(--paper, #fafaf6);
    border: 1px solid var(--line);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--ink);
    background: var(--inverse);
    color: var(--ink);
    text-decoration: none;
    font-weight: 620;
  }
  .button--primary {
    background: var(--ink);
    color: var(--inverse);
  }
</style>
