---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../lib/content-adapter.ts';
import { tFor } from '../../lib/ui-strings.ts';
import { pickLocale, type Locale } from '../../lib/strapi-client.ts';
import { fixtureServices, fixtureTestimonials } from '../../lib/fixtures.ts';
import { localeFromPath, localizedHref } from '../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});

const [services, locations, settings, testimonials] = await Promise.all([
  adapter.fetchServices(),
  adapter.fetchLocations(),
  adapter.fetchSiteSettings(),
  adapter.fetchTestimonials(),
]);

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
const servicesForLocale = services.length > 0 ? services : fixtureServices;
const testimonialsForLocale = testimonials.length > 0 ? testimonials : fixtureTestimonials;
const contentSourceLabel = adapter.source === 'strapi' ? 'CMS content' : 'sample content';

const priceFormatter = new Intl.NumberFormat(locale === 'id' ? 'id-ID' : 'en-US');
---

<BaseLayout
  title={pickLocale(settings.brand, locale)}
  description={pickLocale(settings.tagline, locale)}
  locale={locale}
>
  <section class="container hero" aria-labelledby="hero-title">
    <p class="label">{t.home.eyebrow} · {contentSourceLabel}</p>
    <h1 id="hero-title">{pickLocale(settings.tagline, locale)}</h1>
    <p class="hero__lead">{t.home.lead}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={localizedHref(locale, '/services/')}>
        {t.home.ctaServices}
      </a>
      <a class="button" href={localizedHref(locale, '/booking/')}>{t.home.ctaBook}</a>
    </div>
  </section>

  <section class="container proof" aria-label={t.home.sectionWhat}>
    <header class="section-head">
      <p class="label">{t.home.sectionWhat}</p>
      <h2>{t.home.sectionWhatHeading}</h2>
    </header>
    <ul class="grid">
      {
        servicesForLocale.slice(0, 4).map((service) => (
          <li class="card">
            <h3>
              <a href={localizedHref(locale, `/services/${service.slug}/`)}>
                {pickLocale(service.name, locale)}
              </a>
            </h3>
            <p>{pickLocale(service.summary, locale)}</p>
            <p class="card__price">
              {t.home.startingFrom} {priceFormatter.format(service.startingPriceIdr)}{' '}
              {t.home.currency}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container proof" aria-label={t.home.sectionWhere}>
    <header class="section-head">
      <p class="label">{t.home.sectionWhere}</p>
      <h2>{t.home.sectionWhereHeading}</h2>
    </header>
    <ul class="grid">
      {
        locations.map((location) => (
          <li class="card">
            <h3>
              <a href={localizedHref(locale, `/locations/${location.slug}/`)}>
                {pickLocale(location.name, locale)}
              </a>
            </h3>
            <p>
              {pickLocale(location.region, locale)} · {location.serviceCount}{' '}
              {locale === 'id' ? 'layanan' : 'services'}
            </p>
            <p class="card__price">
              {t.home.responseTime}: {location.responseTimeMinutes} {t.home.minutes}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    testimonialsForLocale.length > 0 && (
      <section class="container proof" aria-label={t.home.sectionTestimonials}>
        <header class="section-head">
          <p class="label">{t.home.sectionTestimonials}</p>
          <h2>{t.home.sectionTestimonialsHeading}</h2>
        </header>
        <ul class="grid grid--wide">
          {testimonialsForLocale.slice(0, 3).map((tm) => (
            <li class="testimonial">
              <blockquote>“{pickLocale(tm.quote, locale)}”</blockquote>
              <p class="attribution">
                <strong>{tm.author}</strong> · {pickLocale(tm.location, locale)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem);
    display: grid;
    gap: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .hero h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 22ch;
  }
  .hero__lead {
    margin: 0;
    max-width: 60ch;
    color: var(--soft-ink);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .proof {
    padding-block: clamp(2rem, 6vw, 5rem);
    display: grid;
    gap: var(--space-lg, 1.5rem);
    border-bottom: 1px solid var(--line);
  }
  .section-head h2 {
    margin: 0.25rem 0 0;
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.035em;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem 1.5rem;
  }
  .grid--wide {
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
  .card {
    padding-block: var(--space-md, 1rem);
    border-top: 1px solid var(--line);
  }
  .card h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-sans);
    font-size: 1.125rem;
  }
  .card a {
    border-bottom: 2px solid transparent;
  }
  .card a:hover,
  .card a:focus-visible {
    border-bottom-color: var(--accent);
  }
  .card p {
    margin: 0;
    color: var(--soft-ink);
  }
  .card__price {
    margin-top: 0.4rem !important;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .testimonial {
    padding: 1rem 1.1rem;
    border-top: 1px solid var(--line);
  }
  blockquote {
    margin: 0 0 0.6rem;
    font-style: italic;
  }
  .attribution {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
</style>
