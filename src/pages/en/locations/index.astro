---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../../lib/content-adapter.ts';
import { tFor } from '../../../lib/ui-strings.ts';
import { pickLocale, type Locale } from '../../../lib/strapi-client.ts';
import { localeFromPath, localizedHref } from '../../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const locations = await adapter.fetchLocations();
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
---

<BaseLayout title={t.locations.title} description={t.locations.pageLead} locale={locale}>
  <section class="container page" aria-labelledby="locations-title">
    <p class="label">{t.locations.title} · {locations.length}</p>
    <h1 id="locations-title">{t.locations.pageHeading}</h1>
    <p class="lead">{t.locations.pageLead}</p>

    <ul class="grid">
      {
        locations.map((location) => (
          <li class="card">
            <h2>
              <a href={localizedHref(locale, `/locations/${location.slug}/`)}>
                {pickLocale(location.name, locale)}
              </a>
            </h2>
            <p>{pickLocale(location.region, locale)}</p>
            <p class="meta">
              {location.responseTimeMinutes} {t.location.minutes} · {location.serviceCount}{' '}
              {locale === 'id' ? 'layanan' : 'services'}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
  }
  .lead {
    color: var(--soft-ink);
    margin: 0;
    max-width: 60ch;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem 1.5rem;
  }
  .card {
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.4rem;
  }
  .card h2 {
    margin: 0;
    font-size: 1.2rem;
  }
  .card a {
    border-bottom: 2px solid transparent;
  }
  .card a:hover,
  .card a:focus-visible {
    border-bottom-color: var(--accent);
  }
  .card p {
    margin: 0;
    color: var(--soft-ink);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
</style>
