---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../../lib/content-adapter.ts';
import { tFor } from '../../../lib/ui-strings.ts';
import { pickLocale, type Locale } from '../../../lib/strapi-client.ts';
import { fixtureServices } from '../../../lib/fixtures.ts';
import { localeFromPath, localizedHref } from '../../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const services = await adapter.fetchServices();
const servicesForLocale = services.length > 0 ? services : fixtureServices;

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

const priceFormatter = new Intl.NumberFormat(locale === 'id' ? 'id-ID' : 'en-US');
---

<BaseLayout title={t.services.title} description={t.services.pageLead} locale={locale}>
  <section class="container page" aria-labelledby="services-title">
    <p class="label">{t.services.title} · {servicesForLocale.length}</p>
    <h1 id="services-title">{t.services.pageHeading}</h1>
    <p class="lead">{t.services.pageLead}</p>

    <ul class="list">
      {
        servicesForLocale.map((service) => (
          <li class="row">
            <h2>
              <a href={localizedHref(locale, `/services/${service.slug}/`)}>
                {pickLocale(service.name, locale)}
              </a>
            </h2>
            <p class="summary">{pickLocale(service.summary, locale)}</p>
            <p class="meta">
              <span>
                {t.home.startingFrom} {priceFormatter.format(service.startingPriceIdr)}{' '}
                {t.home.currency}
              </span>
              <span>·</span>
              <span>
                ~{service.durationMinutes} {t.service.minutes}
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
  }
  .lead {
    color: var(--soft-ink);
    margin: 0;
    max-width: 60ch;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .row {
    border-top: 1px solid var(--line);
    padding-block: 1rem;
    display: grid;
    gap: 0.5rem;
  }
  .row h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .row h2 a {
    border-bottom: 2px solid transparent;
  }
  .row h2 a:hover,
  .row h2 a:focus-visible {
    border-bottom-color: var(--accent);
  }
  .summary {
    color: var(--soft-ink);
    margin: 0;
  }
  .meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--soft-ink);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }
</style>
