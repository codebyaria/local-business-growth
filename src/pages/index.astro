---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createContentAdapter } from '../lib/content-adapter.ts';
import { tFor } from '../lib/ui-strings.ts';
import { pickLocale, type Locale } from '../lib/strapi-client.ts';
import { fixtureServices, fixtureTestimonials } from '../lib/fixtures.ts';
import { localeFromPath, localizedHref } from '../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});

const [services, locations, settings, testimonials] = await Promise.all([
  adapter.fetchServices(),
  adapter.fetchLocations(),
  adapter.fetchSiteSettings(),
  adapter.fetchTestimonials(),
]);

const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
const servicesForLocale = services.length > 0 ? services : fixtureServices;
const testimonialsForLocale = testimonials.length > 0 ? testimonials : fixtureTestimonials;
const contentSourceLabel = adapter.source === 'strapi' ? 'CMS content' : 'sample content';
const firstService = servicesForLocale[0];
const firstLocation = locations[0];

const priceFormatter = new Intl.NumberFormat(locale === 'id' ? 'id-ID' : 'en-US');
const trustItems =
  locale === 'id'
    ? ['Teknisi area terdekat', 'Estimasi harga jelas', 'Booking via WhatsApp', 'Siap Strapi CMS']
    : ['Nearest-area technician', 'Clear price estimate', 'WhatsApp booking', 'Strapi CMS-ready'];
const howItWorks =
  locale === 'id'
    ? [
        ['Pilih layanan', 'Pilih keluhan dan tipe unit dari halaman booking.'],
        ['Kami cek area', 'Permintaan diarahkan ke teknisi terdekat berdasarkan lokasi.'],
        ['Jadwal dikonfirmasi', 'Pelanggan menerima follow-up WhatsApp dan nomor referensi.'],
      ]
    : [
        ['Choose a service', 'Select the issue and unit type from the booking page.'],
        ['We check the area', 'The request routes to the nearest available technician.'],
        ['Schedule confirmed', 'Customers receive WhatsApp follow-up and a reference number.'],
      ];
---

<BaseLayout
  title={pickLocale(settings.brand, locale)}
  description={pickLocale(settings.tagline, locale)}
  locale={locale}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="pill">❄ {t.home.eyebrow} · {contentSourceLabel}</p>
        <h1 id="hero-title">{pickLocale(settings.tagline, locale)}</h1>
        <p class="hero__lead">{t.home.lead}</p>
        <div class="hero__actions">
          <a class="button button--primary" href={localizedHref(locale, '/booking/')}
            >{t.home.ctaBook}</a
          >
          <a class="button" href={localizedHref(locale, '/services/')}>{t.home.ctaServices}</a>
        </div>
        <ul
          class="trust-strip"
          aria-label={locale === 'id' ? 'Sinyal kepercayaan' : 'Trust signals'}
        >
          {trustItems.map((item) => <li>✓ {item}</li>)}
        </ul>
      </div>

      <aside
        class="hero-feature"
        aria-label={locale === 'id' ? 'Ringkasan booking' : 'Booking summary'}
      >
        <div class="floating-badge floating-badge--availability">
          <span aria-hidden="true">⚡</span>
          <strong>{locale === 'id' ? 'Same-day tersedia' : 'Same-day available'}</strong>
        </div>
        <div class="floating-badge floating-badge--arrival">
          <span aria-hidden="true">◴</span>
          <strong>{firstLocation?.responseTimeMinutes ?? 90} {t.home.minutes}</strong>
          <small>{locale === 'id' ? 'Estimasi tiba' : 'Estimated arrival'}</small>
        </div>

        <div class="service-visual-card">
          <div class="service-visual-card__head">
            <div>
              <p>{locale === 'id' ? 'Layanan populer' : 'Popular service'}</p>
              <h2>{firstService ? pickLocale(firstService.name, locale) : t.services.title}</h2>
              <span
                >{
                  firstService ? pickLocale(firstService.summary, locale) : t.services.pageLead
                }</span
              >
            </div>
            <div class="ac-illustration" aria-hidden="true">
              <picture>
                <source
                  srcset="/images/ac-unit-420.webp 420w, /images/ac-unit-640.webp 640w"
                  type="image/webp"
                  sizes="(max-width: 860px) 220px, 260px"
                />
                <img
                  src="/images/ac-unit-420.png"
                  alt=""
                  width="420"
                  height="203"
                  loading="eager"
                  decoding="async"
                />
              </picture>
            </div>
          </div>
          <p class="price-line">
            {t.home.startingFrom}
            <strong
              >{firstService ? priceFormatter.format(firstService.startingPriceIdr) : '150.000'}
              {t.home.currency}</strong
            >
          </p>
          <div class="booking-fields" aria-hidden="true">
            <div>
              <span>▣ {locale === 'id' ? 'Tanggal service' : 'Service date'}</span>
              <strong>{locale === 'id' ? 'Hari ini' : 'Today'}</strong>
            </div>
            <div>
              <span>◷ {locale === 'id' ? 'Jam pilihan' : 'Preferred time'}</span>
              <strong>10:30</strong>
            </div>
          </div>
          <div class="technician-row">
            <div class="avatar" aria-hidden="true">BS</div>
            <div>
              <strong>Budi Santoso</strong>
              <span
                >{
                  locale === 'id' ? 'Spesialis AC · 4.9 rating' : 'AC specialist · 4.9 rating'
                }</span
              >
            </div>
            <em>{locale === 'id' ? 'Tersedia' : 'Available'}</em>
          </div>
          <a class="book-strip" href={localizedHref(locale, '/booking/')}>▣ {t.home.ctaBook} →</a>
        </div>

        <div class="floating-badge floating-badge--area">
          <span aria-hidden="true">📍</span>
          <strong>{locale === 'id' ? 'Jabodetabek' : 'Jakarta areas'}</strong>
        </div>
      </aside>
    </div>
  </section>

  <section class="container services-section" aria-label={t.home.sectionWhat}>
    <div class="section-head section-head--split">
      <div>
        <p class="label">{t.home.sectionWhat}</p>
        <h2>{t.home.sectionWhatHeading}</h2>
      </div>
      <a href={localizedHref(locale, '/services/')}
        >{locale === 'id' ? 'Semua layanan →' : 'All services →'}</a
      >
    </div>
    <ul class="service-grid">
      {
        servicesForLocale.slice(0, 4).map((service) => (
          <li class="service-card">
            <span class="service-card__icon" aria-hidden="true">
              ❄
            </span>
            <h3>
              <a href={localizedHref(locale, `/services/${service.slug}/`)}>
                {pickLocale(service.name, locale)}
              </a>
            </h3>
            <p>{pickLocale(service.summary, locale)}</p>
            <div class="service-card__meta">
              <span>
                {priceFormatter.format(service.startingPriceIdr)} {t.home.currency}
              </span>
              <span>
                {service.durationMinutes} {t.service.minutes}
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container split-section" aria-label={t.home.sectionWhere}>
    <div class="area-panel">
      <p class="label">{t.home.sectionWhere}</p>
      <h2>{t.home.sectionWhereHeading}</h2>
      <p>
        {
          locale === 'id'
            ? 'Area dibuat sebagai landing lokal agar halaman bisa menargetkan pencarian service AC di tiap wilayah.'
            : 'Service areas are structured as local landing pages for region-specific search intent.'
        }
      </p>
      <a class="button" href={localizedHref(locale, '/locations/')}
        >{locale === 'id' ? 'Lihat area' : 'View areas'}</a
      >
    </div>
    <ul class="area-list">
      {
        locations.slice(0, 6).map((location) => (
          <li>
            <span>{pickLocale(location.name, locale)}</span>
            <strong>
              {location.responseTimeMinutes} {t.home.minutes}
            </strong>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="container process-section"
    aria-label={locale === 'id' ? 'Cara kerja booking' : 'How booking works'}
  >
    <div class="section-head">
      <p class="label">{locale === 'id' ? 'Cara kerja' : 'How it works'}</p>
      <h2>
        {
          locale === 'id'
            ? 'Dari landing page ke jadwal teknisi.'
            : 'From landing page to technician schedule.'
        }
      </h2>
    </div>
    <ol class="steps">
      {
        howItWorks.map(([title, body], index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    testimonialsForLocale.length > 0 && (
      <section class="container testimonials" aria-label={t.home.sectionTestimonials}>
        <div class="section-head section-head--center">
          <p class="label">{t.home.sectionTestimonials}</p>
          <h2>{t.home.sectionTestimonialsHeading}</h2>
        </div>
        <ul class="testimonial-grid">
          {testimonialsForLocale.slice(0, 3).map((tm) => (
            <li class="testimonial">
              <blockquote>“{pickLocale(tm.quote, locale)}”</blockquote>
              <p class="attribution">
                <strong>{tm.author}</strong> · {pickLocale(tm.location, locale)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 6vw, 5.5rem);
  }
  .hero::after {
    position: absolute;
    inset: auto -8rem -10rem auto;
    width: 28rem;
    height: 28rem;
    border-radius: 999px;
    background: rgb(255 209 102 / 36%);
    content: '';
    filter: blur(20px);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(19rem, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: 1.25rem;
  }
  .hero h1 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.55rem, 6.25vw, 5.35rem);
    font-weight: 610;
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  .hero__lead {
    margin: 0;
    max-width: 58ch;
    color: var(--soft-ink);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }
  .hero__actions,
  .section-head--split {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .trust-strip li {
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 72%);
    color: var(--soft-ink);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .hero-feature {
    position: relative;
    min-height: 31rem;
  }
  .service-visual-card {
    position: relative;
    display: grid;
    gap: 1.15rem;
    margin-top: 2.9rem;
    padding: clamp(1.1rem, 3vw, 1.65rem);
    border: 1px solid rgb(255 255 255 / 72%);
    border-radius: 2rem;
    background: linear-gradient(180deg, rgb(255 255 255 / 94%), rgb(255 255 255 / 82%));
    box-shadow: 0 26px 70px rgb(20 74 92 / 13%);
    backdrop-filter: blur(18px);
  }
  .service-visual-card::before {
    position: absolute;
    inset: 34% auto auto -5.5rem;
    width: 7rem;
    height: 7rem;
    border: 3px dashed rgb(0 166 147 / 28%);
    border-radius: 999px;
    content: '';
  }
  .service-visual-card__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    gap: 1rem;
    align-items: center;
  }
  .service-visual-card__head p,
  .service-visual-card__head h2,
  .price-line {
    margin: 0;
  }
  .service-visual-card__head p,
  .service-visual-card__head span,
  .booking-fields span,
  .floating-badge small {
    color: var(--soft-ink);
    font-size: 0.86rem;
  }
  .service-visual-card__head h2 {
    margin-block: 0.2rem;
    color: var(--ink);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 610;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .ac-illustration {
    position: relative;
    display: grid;
    justify-items: end;
    min-height: 5.8rem;
  }
  .ac-illustration::after {
    position: absolute;
    inset: 3.7rem 0.8rem auto auto;
    width: 7.4rem;
    height: 2.8rem;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(0 166 147 / 20%), transparent 68%);
    content: '';
    filter: blur(5px);
  }
  .ac-illustration picture,
  .ac-illustration img {
    position: relative;
    z-index: 1;
    display: block;
  }
  .ac-illustration img {
    width: min(100%, 10.7rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 16px 22px rgb(90 107 118 / 16%));
  }
  .price-line {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--soft-ink);
  }
  .price-line strong {
    color: var(--accent-strong);
    font-size: 1.15rem;
  }
  .booking-fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .booking-fields div {
    display: grid;
    gap: 0.35rem;
    padding: 0.78rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fbfdff;
  }
  .booking-fields strong {
    font-weight: 600;
  }
  .technician-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.8rem;
    align-items: center;
  }
  .avatar {
    display: grid;
    width: 54px;
    height: 54px;
    place-items: center;
    border-radius: 999px;
    background: linear-gradient(135deg, #0b806f, #d8f7f1);
    color: var(--inverse);
    font-weight: 610;
  }
  .technician-row > div:nth-child(2) {
    display: grid;
    line-height: 1.3;
  }
  .technician-row span {
    color: var(--soft-ink);
  }
  .technician-row em {
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    padding: 0.35rem 0.65rem;
    font-size: 0.82rem;
    font-style: normal;
    font-weight: 610;
  }
  .book-strip {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    min-height: 54px;
    align-items: center;
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: var(--inverse);
    font-weight: 610;
    text-decoration: none;
  }
  .floating-badge {
    position: absolute;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    align-items: center;
    padding: 0.75rem 1rem;
    border: 1px solid rgb(255 255 255 / 76%);
    border-radius: 999px;
    background: rgb(255 255 255 / 82%);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(12px);
  }
  .floating-badge span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 999px;
    background: var(--accent);
    color: var(--inverse);
  }
  .floating-badge strong {
    color: var(--accent-strong);
    font-size: 0.9rem;
    line-height: 1.1;
  }
  .floating-badge--availability {
    top: 0;
    right: 1rem;
  }
  .floating-badge--arrival {
    top: 8.5rem;
    left: -3rem;
  }
  .floating-badge--arrival {
    grid-template-columns: auto 1fr;
  }
  .floating-badge--arrival small {
    grid-column: 2;
    grid-row: 1;
    margin-top: -0.85rem;
  }
  .floating-badge--arrival strong {
    grid-column: 2;
    grid-row: 2;
    font-size: 1.05rem;
  }
  .floating-badge--area {
    right: -2rem;
    bottom: 2.8rem;
  }
  .services-section,
  .split-section,
  .process-section,
  .testimonials {
    padding-block: clamp(2.5rem, 7vw, 5.5rem);
  }
  .section-head {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .section-head h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.25vw, 2.7rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .section-head--split {
    justify-content: space-between;
  }
  .section-head--split a {
    color: var(--accent-strong);
    font-weight: 620;
    text-decoration: none;
  }
  .service-grid,
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .service-card,
  .testimonial {
    display: grid;
    gap: 0.8rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .service-card__icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 16px;
    background: var(--accent-soft);
  }
  .service-card h3,
  .service-card p {
    margin: 0;
  }
  .service-card a {
    text-decoration: none;
  }
  .service-card p {
    color: var(--soft-ink);
  }
  .service-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.7rem;
    color: var(--accent-strong);
    font-size: 0.86rem;
    font-weight: 620;
  }
  .split-section {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 1rem;
    align-items: stretch;
  }
  .area-panel,
  .area-list {
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .area-panel {
    display: grid;
    align-content: center;
    gap: 1rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .area-panel h2,
  .area-panel p {
    margin: 0;
  }
  .area-panel p {
    color: var(--soft-ink);
  }
  .area-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0.7rem;
    list-style: none;
  }
  .area-list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 1rem;
  }
  .area-list li:nth-child(odd) {
    background: var(--surface-tint);
  }
  .area-list strong {
    color: var(--accent-strong);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    padding: 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .steps span {
    color: var(--sun-strong);
    font-family: var(--font-mono);
    font-weight: 620;
  }
  .steps h3 {
    margin: 0.7rem 0 0.35rem;
  }
  .steps p,
  .testimonial blockquote,
  .attribution {
    margin: 0;
    color: var(--soft-ink);
  }
  .section-head--center {
    text-align: center;
    justify-items: center;
  }
  .testimonial blockquote {
    color: var(--ink);
    font-size: 1.05rem;
  }
  @media (max-width: 860px) {
    .hero__grid,
    .split-section,
    .steps {
      grid-template-columns: 1fr;
    }
    .hero h1 {
      max-width: 12ch;
      font-size: clamp(2.45rem, 12vw, 4rem);
    }
    .hero-feature {
      min-height: auto;
    }
    .service-visual-card {
      margin-top: 2.6rem;
    }
    .floating-badge--arrival,
    .floating-badge--area {
      display: none;
    }
    .floating-badge--availability {
      right: 0.5rem;
    }
    .service-visual-card__head,
    .booking-fields,
    .technician-row {
      grid-template-columns: 1fr;
    }
  }
</style>
