---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../lib/content-adapter.ts';
import { tFor } from '../../lib/ui-strings.ts';
import { pickLocale, type Locale, type Location } from '../../lib/strapi-client.ts';
import { localeFromPath, localizedHref } from '../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const all = await adapter.fetchLocations();

export async function getStaticPaths() {
  const adapter = createContentAdapter({
    strapiUrl: import.meta.env.STRAPI_URL,
    strapiToken: import.meta.env.STRAPI_TOKEN,
  });
  const all = await adapter.fetchLocations();
  return all.map((location) => ({
    params: { slug: location.slug },
  }));
}

export const prerender = true;

const { slug } = Astro.params;
const locale: Locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);

const location: Location | undefined = all.find((l) => l.slug === slug);
if (!location) {
  return Astro.redirect(localizedHref(locale, '/locations/'), 302);
}
---

<BaseLayout
  title={pickLocale(location.name, locale)}
  description={`${pickLocale(location.region, locale)} · ${location.serviceCount} ${locale === 'id' ? 'layanan' : 'services'}`}
  locale={locale}
>
  <article class="container location">
    <p class="label">{t.location.eyebrow}</p>
    <h1>{pickLocale(location.name, locale)}</h1>
    <p class="lead">{pickLocale(location.region, locale)}</p>

    <dl class="meta-grid">
      <div>
        <dt>{t.location.responseTime}</dt>
        <dd>~{location.responseTimeMinutes} {t.location.minutes}</dd>
      </div>
      <div>
        <dt>{t.location.servicesAvailable}</dt>
        <dd>{location.serviceCount}</dd>
      </div>
    </dl>

    <div class="cta">
      <a class="button button--primary" href={localizedHref(locale, '/booking/')}>
        {t.home.ctaBook}
      </a>
      <a class="back" href={localizedHref(locale, '/locations/')}>
        {t.location.backToLocations}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .location {
    padding-block: clamp(2rem, 5vw, 4rem);
    display: grid;
    gap: 1rem;
    max-width: 720px;
  }
  .lead {
    color: var(--soft-ink);
    margin: 0;
    font-size: 1.05rem;
  }
  .meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin: 0;
    padding-block: 0.5rem;
    border-block: 1px solid var(--line);
  }
  .meta-grid dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--soft-ink);
  }
  .meta-grid dd {
    margin: 0.15rem 0 0;
    font-size: 1.1rem;
    font-weight: 620;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--ink);
    text-decoration: none;
    font-weight: 620;
  }
  .button--primary {
    background: var(--ink);
    color: var(--inverse);
  }
  .back {
    font-size: 0.9rem;
  }
</style>
