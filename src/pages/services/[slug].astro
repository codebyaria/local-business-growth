---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../lib/content-adapter.ts';
import { tFor } from '../../lib/ui-strings.ts';
import { pickLocale, type Locale, type Service } from '../../lib/strapi-client.ts';
import { fixtureServices } from '../../lib/fixtures.ts';
import { localizedHref } from '../../lib/i18n.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const all = await adapter.fetchServices();
const allForLocale = all.length > 0 ? all : fixtureServices;

export async function getStaticPaths() {
  const adapter = createContentAdapter({
    strapiUrl: import.meta.env.STRAPI_URL,
    strapiToken: import.meta.env.STRAPI_TOKEN,
  });
  const all = await adapter.fetchServices();
  const allForLocale = all.length > 0 ? all : fixtureServices;
  return allForLocale.map((service) => ({
    params: { slug: service.slug },
  }));
}

export const prerender = true;

const { slug } = Astro.params;
const locale: Locale = (Astro.currentLocale as Locale) ?? 'id';
const t = tFor(locale);

const service: Service | undefined = allForLocale.find((s) => s.slug === slug);
if (!service) {
  return Astro.redirect(localizedHref(locale, '/services/'), 302);
}

const related = allForLocale.filter((s) => s.slug !== service.slug).slice(0, 3);
const priceFormatter = new Intl.NumberFormat(locale === 'id' ? 'id-ID' : 'en-US');
---

<BaseLayout
  title={pickLocale(service.name, locale)}
  description={pickLocale(service.summary, locale)}
  locale={locale}
>
  <article class="container service">
    <p class="label">{t.service.eyebrow}</p>
    <h1>{pickLocale(service.name, locale)}</h1>
    <p class="lead">{pickLocale(service.summary, locale)}</p>

    <dl class="meta-grid">
      <div>
        <dt>{t.service.startingFrom}</dt>
        <dd>
          {priceFormatter.format(service.startingPriceIdr)}
          {t.home.currency}
        </dd>
      </div>
      <div>
        <dt>{t.service.duration}</dt>
        <dd>~{service.durationMinutes} {t.service.minutes}</dd>
      </div>
    </dl>

    <p class="description">{pickLocale(service.description, locale)}</p>

    <div class="cta">
      <a class="button button--primary" href={localizedHref(locale, '/booking/')}>
        {t.home.ctaBook}
      </a>
      <a class="back" href={localizedHref(locale, '/services/')}>{t.service.backToServices}</a>
    </div>

    {
      related.length > 0 && (
        <section class="related" aria-label={t.service.related}>
          <h2>{t.service.related}</h2>
          <ul>
            {related.map((s) => (
              <li>
                <a href={localizedHref(locale, `/services/${s.slug}/`)}>
                  {pickLocale(s.name, locale)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .service {
    padding-block: clamp(2rem, 5vw, 4rem);
    display: grid;
    gap: 1.1rem;
    max-width: 720px;
  }
  .lead {
    color: var(--soft-ink);
    font-size: 1.1rem;
    margin: 0;
  }
  .meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin: 0;
    padding-block: 0.5rem;
    border-block: 1px solid var(--line);
  }
  .meta-grid dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--soft-ink);
  }
  .meta-grid dd {
    margin: 0.15rem 0 0;
    font-size: 1.1rem;
    font-weight: 700;
  }
  .description {
    line-height: 1.65;
    color: var(--ink);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--ink);
    text-decoration: none;
    font-weight: 700;
  }
  .button--primary {
    background: var(--ink);
    color: var(--inverse);
  }
  .back {
    font-size: 0.9rem;
  }
  .related {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .related h2 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
  }
  .related ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
  .related a {
    border-bottom: 2px solid transparent;
  }
  .related a:hover,
  .related a:focus-visible {
    border-bottom-color: var(--accent);
  }
</style>
