---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createContentAdapter } from '../../lib/content-adapter.ts';

const adapter = createContentAdapter({
  strapiUrl: import.meta.env.STRAPI_URL,
  strapiToken: import.meta.env.STRAPI_TOKEN,
});
const services = await adapter.fetchServices();
---

<BaseLayout
  title="Services"
  description="Roofing services for a fictional Northside Roofing business, served from a Strapi-ready content adapter."
>
  <section class="container page" aria-labelledby="services-title">
    <p class="label">Services · {services.length}</p>
    <h1 id="services-title">What we do, in plain language.</h1>
    <ul class="list">
      {
        services.map((service) => (
          <li>
            <h2>
              <a href={`/services/${service.slug}/`}>{service.name}</a>
            </h2>
            <p class="summary">{service.summary}</p>
            <p class="description">{service.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2rem, 6vw, 5rem);
    display: grid;
    gap: var(--space-lg, 1.5rem);
  }
  h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 22ch;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    padding-block: var(--space-lg, 1.5rem);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 0.5rem;
  }
  .list h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    letter-spacing: -0.03em;
  }
  .list h2 a {
    border-bottom: 2px solid transparent;
  }
  .list h2 a:hover,
  .list h2 a:focus-visible {
    border-bottom-color: var(--accent);
  }
  .summary {
    margin: 0;
    font-weight: 700;
  }
  .description {
    margin: 0;
    color: var(--soft-ink);
    max-width: 60ch;
  }
</style>
